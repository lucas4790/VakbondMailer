<Window x:Class="VakbondMailer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vakbond Mailer" Height="920" Width="1080" MinHeight="680" MinWidth="820"
        Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Center" Margin="28">

            <!-- Masthead -->
            <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,18" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vakbond Mailer" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Eén standaardmail, persoonlijk gemaakt voor elk lid." Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource GoodSoftBrush}" CornerRadius="999" Padding="10,5" VerticalAlignment="Top">
                        <TextBlock Text="Verstuurt via Outlook" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Step tracker -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource TrackerCardBorder}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Ledenlijst" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="CSV inladen" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TrackerCardBorder}" Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Bericht" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Sjabloon + velden" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TrackerCardBorder}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Versturen" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Testen &amp; verzenden" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Step 1: Ledenlijst -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="01" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="Ledenlijst" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillBorder}">
                            <TextBlock x:Name="RecipientCountText" Style="{StaticResource PillText}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChooseFileButton" Grid.Column="0" Content="Bestand kiezen..." VerticalAlignment="Center" Click="ChooseFileButton_Click"/>
                        <TextBlock x:Name="FilePathText" Grid.Column="2" Text="Nog geen bestand geladen" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkFaintBrush}" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="E-MAILKOLOM" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox x:Name="EmailColumnComboBox" SelectionChanged="EmailColumnComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="PreviewDataGrid"
                                  AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                  BorderThickness="0" Background="{StaticResource PaperRaisedBrush}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                  CellStyle="{StaticResource ModernCell}"
                                  RowStyle="{StaticResource ModernRow}"
                                  AlternationCount="2"
                                  MaxHeight="230" RowHeight="32"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 2: Bericht -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="02" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Bericht" Style="{StaticResource SectionHeaderText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="ONDERWERP" Style="{StaticResource FieldLabelText}"/>
                        <Border Style="{StaticResource InputChrome}">
                            <TextBox x:Name="SubjectTextBox" Style="{StaticResource BareTextBox}" GotFocus="SubjectTextBox_GotFocus" TextChanged="Template_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="VELD INVOEGEN — KLIK OM TOE TE VOEGEN OP DE CURSORPOSITIE" Style="{StaticResource FieldLabelText}"/>
                        <WrapPanel x:Name="PlaceholderPanel"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TEKST" Style="{StaticResource FieldLabelText}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox x:Name="BodyTextBox" Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="200"
                                         GotFocus="BodyTextBox_GotFocus" TextChanged="Template_TextChanged"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LIVE VOORBEELD — EERSTE RIJ UIT DE LIJST" Style="{StaticResource FieldLabelText}"/>
                            <Border Background="{StaticResource PaperSunkenBrush}" CornerRadius="8" Padding="14" Height="200">
                                <StackPanel>
                                    <TextBlock x:Name="MergedPreviewSubject" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Separator Margin="0,0,0,8" Opacity="0.4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="MergedPreviewBody" TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}" FontSize="13"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="SaveTemplateButton" Content="Sjabloon opslaan..." Style="{StaticResource GhostButton}" Click="SaveTemplateButton_Click"/>
                        <Button x:Name="LoadTemplateButton" Content="Sjabloon laden..." Style="{StaticResource GhostButton}" Click="LoadTemplateButton_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Step 3: Versturen -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="03" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Versturen" Style="{StaticResource SectionHeaderText}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="SendTestButton" Content="Stuur testmail naar mezelf" Click="SendTestButton_Click"/>
                        <Button x:Name="SendAllButton" Content="Verstuur naar iedereen" Style="{StaticResource PrimaryButton}" Click="SendAllButton_Click" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ProgressBar x:Name="SendProgressBar" Style="{StaticResource ThinProgressBar}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Nog niet verstuurd" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource InkFaintBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="LOGBOEK" Style="{StaticResource FieldLabelText}"/>
                    <Border Background="{StaticResource PaperSunkenBrush}" CornerRadius="8" Padding="8">
                        <ScrollViewer x:Name="LogScrollViewer" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PaperRaisedBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource InkFaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource InkFaintBrush}" Margin="8,0,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource ChipOk}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Verstuurd" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource ChipFail}" Visibility="{Binding IsFailure, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Mislukt" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Vakbond Mailer — verzendt via je eigen, al ingelogde Outlook." HorizontalAlignment="Center"
                       FontSize="11.5" Foreground="{StaticResource InkFaintBrush}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
