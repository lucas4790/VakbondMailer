<Application x:Class="VakbondMailer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ============ Palette (FNV-huisstijlkleuren: blauw #009CDE, groen #7FBA24 uit hun eigen logo) ============ -->
        <SolidColorBrush x:Key="InkBrush" Color="#FF14202B"/>
        <SolidColorBrush x:Key="InkSoftBrush" Color="#FF4A5A68"/>
        <SolidColorBrush x:Key="InkFaintBrush" Color="#FF7C8993"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFF0F3F5"/>
        <SolidColorBrush x:Key="PaperRaisedBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PaperSunkenBrush" Color="#FFE4E9EC"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFD3DADE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF009CDE"/>
        <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFDCF0FA"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#FF7FBA24"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#FF5C8A1E"/>
        <SolidColorBrush x:Key="GoodSoftBrush" Color="#FFE9F4DB"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FFC1443A"/>
        <SolidColorBrush x:Key="BadSoftBrush" Color="#FFF7E3E0"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============ Base ============ -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ============ Typography ============ -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ============ Cards ============ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF1B1E22" Opacity="0.06" BlurRadius="20" ShadowDepth="3" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackerCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Pill ============ -->
        <Style x:Key="PillBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperSunkenBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource PaperRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- Default look for any un-styled button -->
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <!-- ============ Inputs ============ -->
        <Style x:Key="InputChrome" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>

        <!-- ============ DataGrid ============ -->
        <Style x:Key="ModernColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PaperSunkenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ModernCell" TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource PaperRaisedBrush}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Progress bar ============ -->
        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PaperSunkenBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="Transparent"/>
                            <Rectangle x:Name="PART_Indicator" RadiusX="4" RadiusY="4"
                                       Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Status chips ============ -->
        <Style x:Key="ChipOk" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GoodSoftBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ChipFail" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadSoftBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Application.Resources>
</Application>
