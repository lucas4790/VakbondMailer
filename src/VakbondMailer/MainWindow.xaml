<Window x:Class="VakbondMailer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vakbond Mailer" Height="900" Width="1100" MinHeight="700" MinWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Stap 1: bestand kiezen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="1. Ledenlijst:" FontWeight="Bold" VerticalAlignment="Center" Width="140" />
            <Button x:Name="ChooseFileButton" Content="Bestand kiezen..." Click="ChooseFileButton_Click" Padding="8,2" />
            <TextBlock x:Name="FilePathText" Text="(geen bestand geladen)" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="E-mailkolom:" VerticalAlignment="Center" Width="140" />
            <ComboBox x:Name="EmailColumnComboBox" Width="200" SelectionChanged="EmailColumnComboBox_SelectionChanged" />
            <TextBlock x:Name="RecipientCountText" Text="" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" />
        </StackPanel>

        <!-- Preview van ingelezen lijst -->
        <DataGrid x:Name="PreviewDataGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                  Margin="0,0,0,8" HeadersVisibility="Column" />

        <!-- Stap 2: sjabloon -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="2. Standaardmail" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Onderwerp:" VerticalAlignment="Center" Width="140" />
                <TextBox x:Name="SubjectTextBox" Width="500" GotFocus="SubjectTextBox_GotFocus" TextChanged="Template_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Veld invoegen:" VerticalAlignment="Center" Width="140" />
                <ComboBox x:Name="PlaceholderComboBox" Width="200" />
                <Button x:Name="InsertPlaceholderButton" Content="Invoegen in tekst" Margin="8,0,0,0" Padding="8,2" Click="InsertPlaceholderButton_Click" />
                <Button x:Name="SaveTemplateButton" Content="Sjabloon opslaan..." Margin="20,0,0,0" Padding="8,2" Click="SaveTemplateButton_Click" />
                <Button x:Name="LoadTemplateButton" Content="Sjabloon laden..." Margin="8,0,0,0" Padding="8,2" Click="LoadTemplateButton_Click" />
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="BodyTextBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                 GotFocus="BodyTextBox_GotFocus" TextChanged="Template_TextChanged" />

        <!-- Stap 3: versturen -->
        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="3. Versturen" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="SendTestButton" Content="Stuur testmail naar mezelf" Click="SendTestButton_Click" Padding="8,4" />
                <Button x:Name="SendAllButton" Content="Verstuur naar iedereen" Margin="12,0,0,0" Padding="8,4" Click="SendAllButton_Click" />
                <ProgressBar x:Name="SendProgressBar" Width="300" Height="20" Margin="20,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="Live voorbeeld (op basis van de eerste rij uit de lijst):" Margin="0,4,0,2" />
            <TextBox x:Name="MergedPreviewTextBox" Height="60" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#FFF5F5F5" />
        </StackPanel>

        <!-- Logboek -->
        <GroupBox Grid.Row="6" Header="Logboek">
            <ListBox x:Name="LogListBox" />
        </GroupBox>
    </Grid>
</Window>
