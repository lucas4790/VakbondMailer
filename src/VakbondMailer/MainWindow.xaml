<Window x:Class="VakbondMailer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vakbond Mailer" Height="920" Width="1080" MinHeight="680" MinWidth="820"
        Background="{StaticResource PaperBrush}" Icon="app.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Center" Margin="28">

            <!-- Masthead -->
            <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,18" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vakbond Mailer" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Eén standaardmail, persoonlijk gemaakt voor elk lid." Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource GoodSoftBrush}" CornerRadius="999" Padding="10,5" VerticalAlignment="Top">
                        <TextBlock Text="Verstuurt via Outlook" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Step tracker -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource TrackerCardBorder}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Ledenlijst" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="CSV inladen" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TrackerCardBorder}" Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Bericht" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Sjabloon + velden" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TrackerCardBorder}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepBadgeText}"/></Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Versturen" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Testen &amp; verzenden" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Step 1: Ledenlijst -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="01" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="Ledenlijst" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Content="Alles aan" Style="{StaticResource GhostButton}" Click="SelectAllButton_Click"/>
                            <Button x:Name="SelectNoneButton" Content="Alles uit" Style="{StaticResource GhostButton}" Click="SelectNoneButton_Click"/>
                            <Border Style="{StaticResource PillBorder}" Margin="8,0,0,0">
                                <TextBlock x:Name="RecipientCountText" Text="Geen lijst geladen" Style="{StaticResource PillText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChooseFileButton" Grid.Column="0" Content="Bestand kiezen..." VerticalAlignment="Center" Click="ChooseFileButton_Click"/>
                        <TextBlock x:Name="FilePathText" Grid.Column="2" Text="Nog geen bestand geladen" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkFaintBrush}" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="E-MAILKOLOM" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox x:Name="EmailColumnComboBox" SelectionChanged="EmailColumnComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="PreviewDataGrid"
                                  AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  AutoGeneratingColumn="PreviewDataGrid_AutoGeneratingColumn"
                                  CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                  BorderThickness="0" Background="{StaticResource PaperRaisedBrush}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                  CellStyle="{StaticResource ModernCell}"
                                  RowStyle="{StaticResource ModernRow}"
                                  AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserSortColumns="False"
                                  SelectionChanged="PreviewDataGrid_SelectionChanged"
                                  MaxHeight="230" RowHeight="32"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 2: Bericht -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="02" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Bericht" Style="{StaticResource SectionHeaderText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="SJABLONENMAP — STANDAARDMAILS PER ONDERWERP" Style="{StaticResource FieldLabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ChooseTemplateFolderButton" Grid.Column="0" Content="Map kiezen..." VerticalAlignment="Center" Click="ChooseTemplateFolderButton_Click"/>
                            <TextBlock x:Name="TemplateFolderText" Grid.Column="2" Text="Geen map gekozen" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkFaintBrush}" TextTrimming="CharacterEllipsis"/>

                            <ComboBox x:Name="TemplateComboBox" Grid.Column="4" DisplayMemberPath="DisplayName"
                                      SelectionChanged="TemplateComboBox_SelectionChanged"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="GASTLES INPLANNEN — VULT {{Maand}}, {{MaandJaar}} EN {{Datumopties}}" Style="{StaticResource FieldLabelText}"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <ComboBox x:Name="MonthComboBox" Width="200" DisplayMemberPath="Label"
                                          SelectionChanged="MonthComboBox_SelectionChanged"/>
                                <TextBlock x:Name="DateOptionsPreviewText" FontSize="11" TextWrapping="Wrap" Width="200"
                                           Foreground="{StaticResource InkFaintBrush}" Margin="0,8,0,0"/>
                                <Button x:Name="ClearDatesButton" Content="Datums wissen" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Click="ClearDatesButton_Click"/>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                    Margin="16,0,0,0" Padding="4">
                                <Calendar x:Name="ProposalCalendar" SelectionMode="MultipleRange"
                                          SelectedDatesChanged="ProposalCalendar_SelectedDatesChanged"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="ONDERWERP" Style="{StaticResource FieldLabelText}"/>
                        <Border Style="{StaticResource InputChrome}">
                            <TextBox x:Name="SubjectTextBox" Style="{StaticResource BareTextBox}" GotFocus="SubjectTextBox_GotFocus" TextChanged="Template_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="VELD INVOEGEN — KLIK OM TOE TE VOEGEN OP DE CURSORPOSITIE" Style="{StaticResource FieldLabelText}"/>
                        <WrapPanel x:Name="PlaceholderPanel"/>
                        <TextBlock x:Name="PlaceholderWarningText" FontSize="12" Foreground="{StaticResource BadBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TEKST" Style="{StaticResource FieldLabelText}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox x:Name="BodyTextBox" Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="200"
                                         GotFocus="BodyTextBox_GotFocus" TextChanged="Template_TextChanged"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LIVE VOORBEELD — KLIK EEN RIJ HIERBOVEN OM TE WISSELEN" Style="{StaticResource FieldLabelText}"/>
                            <Border Background="{StaticResource PaperSunkenBrush}" CornerRadius="8" Padding="14" Height="200">
                                <StackPanel>
                                    <TextBlock x:Name="PreviewRecipientLabel" FontSize="11" Foreground="{StaticResource InkFaintBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="MergedPreviewSubject" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Separator Margin="0,0,0,8" Opacity="0.4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="MergedPreviewBody" TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}" FontSize="13"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="SaveTemplateButton" Content="Opslaan als nieuw sjabloon..." Style="{StaticResource GhostButton}" Click="SaveTemplateButton_Click"/>
                        <CheckBox x:Name="HtmlFormattingCheckBox" Content="Opmaak herkennen: **vet**, *cursief*, links (HTML)"
                                  VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="BIJLAGEN" Style="{StaticResource FieldLabelText}"/>
                        <Button x:Name="AddAttachmentButton" Content="Bijlage toevoegen..." HorizontalAlignment="Left" Click="AddAttachmentButton_Click"/>
                        <ItemsControl x:Name="AttachmentListControl" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PaperSunkenBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="✕" Style="{StaticResource GhostButton}" Padding="6,0" Margin="6,0,0,0"
                                                    Click="RemoveAttachmentButton_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Step 3: Versturen -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="03" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Versturen" Style="{StaticResource SectionHeaderText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="VERZENDEN VANAF — ALLEEN @FNV.NL-ADRESSEN" Style="{StaticResource FieldLabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AccountComboBox" Grid.Column="0" SelectionChanged="AccountComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshAccountsButton" Grid.Column="2" Content="Accounts vernieuwen"
                                    Style="{StaticResource GhostButton}" Click="RefreshAccountsButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TESTONTVANGER — STANDAARD HET VERZENDACCOUNT" Style="{StaticResource FieldLabelText}"/>
                            <Border Style="{StaticResource InputChrome}" Width="320" HorizontalAlignment="Left">
                                <TextBox x:Name="TestRecipientTextBox" Style="{StaticResource BareTextBox}" TextChanged="TestRecipientTextBox_TextChanged"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PAUZE TUSSEN MAILS (SEC.)" Style="{StaticResource FieldLabelText}"/>
                            <Border Style="{StaticResource InputChrome}" Width="70">
                                <TextBox x:Name="DelayTextBox" Style="{StaticResource BareTextBox}" Text="1" HorizontalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="SendTestButton" Content="Stuur testmail" Click="SendTestButton_Click"/>
                        <Button x:Name="SendAllButton" Content="Verstuur naar iedereen" Style="{StaticResource PrimaryButton}" Click="SendAllButton_Click" Margin="10,0,0,0"/>
                        <Button x:Name="CancelSendButton" Content="Stoppen" Click="CancelSendButton_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="RetryFailedButton" Content="Mislukte opnieuw" Click="RetryFailedButton_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <ProgressBar x:Name="SendProgressBar" Style="{StaticResource ThinProgressBar}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Nog niet verstuurd" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource InkFaintBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="LOGBOEK" Style="{StaticResource FieldLabelText}"/>
                    <Border Background="{StaticResource PaperSunkenBrush}" CornerRadius="8" Padding="8">
                        <ListBox x:Name="LogListBox" MaxHeight="220" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PaperRaisedBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource InkFaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource InkFaintBrush}" Margin="8,0,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource ChipOk}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Verstuurd" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource ChipFail}" Visibility="{Binding IsFailure, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Mislukt" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Vakbond Mailer — verzendt via je eigen, al ingelogde Outlook." HorizontalAlignment="Center"
                       FontSize="11.5" Foreground="{StaticResource InkFaintBrush}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
